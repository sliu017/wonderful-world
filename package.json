{
  "name": "wonderful-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:up && concurrently -n web,api -c cyan,magenta \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "review": "node manual-review/server.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "nodemon": "^3.1.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
